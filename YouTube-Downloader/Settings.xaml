<Window x:Class="YouTube_Downloader.Settings"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:YouTube_Downloader"
        mc:Ignorable="d"
        Title="Beállítások" Height="180" Width="400">
    <Grid Margin="10">
        <StackPanel>
            <GroupBox Header="Formátum">
                <StackPanel Orientation="Horizontal">
                    <RadioButton x:Name="MP3" Content="MP3"/>
                    <RadioButton x:Name="MP4" Content="MP4"/>
                </StackPanel>
            </GroupBox>
            <GroupBox Header="Letöltés helye">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="Folder" Style="{DynamicResource TextBox3Corner}"/>
                    <Button x:Name="Select" Content="Tallózás" Click="Select_Click" Grid.Column="1" Padding="5,0,5,0" Style="{DynamicResource Button3Corner}" />
                </Grid>
            </GroupBox>
            <Button x:Name="Download" Content="Letöltés" Click="Download_Click" Style="{DynamicResource Button3Corner}"/>
        </StackPanel>
    </Grid>
</Window>
